# آدرس نهایی سایت (بعد از دیپلوی روی نتلیفای، آدرس خودت یا دامنه‌ی اختصاصی)
NEXT_PUBLIC_SITE_URL=https://kharidchi.netlify.app

# --- ورود ادمین (حتماً در نتلیفای ست کن؛ بدون این‌ها پنل ادمین در حالت production قفل است) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=یک-رمز-خیلی-قوی-و-طولانی
# یک رشته‌ی تصادفی حداقل ۳۲ کاراکتر (مثلاً با: openssl rand -base64 48)
SESSION_SECRET=

# --- دیتابیس دائمی (پیشنهاد: Turso رایگان). اگر خالی بگذاری از دیتابیس موقت استفاده می‌شود ---
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- اختیاری ---
NEXT_PUBLIC_TELEGRAM=https://t.me/yourid
NEXT_PUBLIC_INSTAGRAM=https://instagram.com/yourid
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com
GOOGLE_SITE_VERIFICATION=
